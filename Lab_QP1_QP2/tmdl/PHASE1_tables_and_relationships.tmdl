createOrReplace

	table FactSales

		column SalesOrderNumber
			dataType: string
			sourceColumn: SalesOrderNumber
			summarizeBy: none

		column OrderDate
			dataType: dateTime
			sourceColumn: OrderDate
			formatString: dd mmm yyyy
			summarizeBy: none

		column DateKey
			dataType: int64
			sourceColumn: DateKey
			summarizeBy: none
			isHidden

		column ProductKey
			dataType: int64
			sourceColumn: ProductKey
			summarizeBy: none
			isHidden

		column CustomerKey
			dataType: int64
			sourceColumn: CustomerKey
			summarizeBy: none
			isHidden

		column TerritoryKey
			dataType: int64
			sourceColumn: TerritoryKey
			summarizeBy: none
			isHidden

		column OrderQuantity
			dataType: int64
			sourceColumn: OrderQuantity
			formatString: #,0
			summarizeBy: sum

		column UnitPrice
			dataType: double
			sourceColumn: UnitPrice
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			summarizeBy: none

		column DiscountPct
			dataType: double
			sourceColumn: DiscountPct
			formatString: 0.00%
			summarizeBy: average

		column SalesAmount
			dataType: double
			sourceColumn: SalesAmount
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			summarizeBy: sum

		column TotalCost
			dataType: double
			sourceColumn: TotalCost
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			summarizeBy: sum

		column Profit
			dataType: double
			sourceColumn: Profit
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			summarizeBy: sum

		column OrderStatus
			dataType: string
			sourceColumn: OrderStatus
			summarizeBy: none

		column 'Net Unit Price' = DIVIDE ( FactSales[SalesAmount], FactSales[OrderQuantity] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			summarizeBy: none

		column 'Line Margin %' = ```
				DIVIDE ( FactSales[SalesAmount] - FactSales[TotalCost],
				         FactSales[SalesAmount] )
				```
			formatString: 0.00%
			summarizeBy: none

		column 'Order Size Band' = ```
				SWITCH ( TRUE (),
				    FactSales[OrderQuantity] <= 2, "1-2 units",
				    FactSales[OrderQuantity] <= 4, "3-4 units",
				    FactSales[OrderQuantity] <= 6, "5-6 units",
				    "7+ units" )
				```
			summarizeBy: none

		measure 'Total Sales' = SUM ( FactSales[SalesAmount] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 01 Sales

		measure 'Total Quantity' = SUM ( FactSales[OrderQuantity] )
			formatString: #,0
			displayFolder: 01 Sales

		measure 'Total Cost' = SUM ( FactSales[TotalCost] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 02 Profit

		measure 'Total Profit' = [Total Sales] - [Total Cost]
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 02 Profit

		measure 'Profit Margin %' = DIVIDE ( [Total Profit], [Total Sales] )
			formatString: 0.00%
			displayFolder: 02 Profit

		measure 'Order Count' = DISTINCTCOUNT ( FactSales[SalesOrderNumber] )
			formatString: #,0
			displayFolder: 01 Sales

		measure 'Average Order Value' = DIVIDE ( [Total Sales], [Order Count] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 01 Sales

		measure 'Average Line Sales' = AVERAGE ( FactSales[SalesAmount] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 01 Sales

		measure 'Average Selling Price' = DIVIDE ( [Total Sales], [Total Quantity] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 01 Sales

		measure 'Customer Count' = DISTINCTCOUNT ( FactSales[CustomerKey] )
			formatString: #,0
			displayFolder: 01 Sales

		measure 'Product Count' = DISTINCTCOUNT ( FactSales[ProductKey] )
			formatString: #,0
			displayFolder: 01 Sales

		measure 'Top Product by Units' = ```
				VAR TopProduct =
				    TOPN ( 1, ALL ( DimProduct[ProductName] ),
				           CALCULATE ( [Total Quantity] ), DESC )
				RETURN
				    CONCATENATEX ( TopProduct, DimProduct[ProductName], ", " )
				```
			displayFolder: 03 Ranking

		measure 'Top Product Units' = ```
				MAXX ( ALL ( DimProduct[ProductName] ),
				       CALCULATE ( [Total Quantity] ) )
				```
			formatString: #,0
			displayFolder: 03 Ranking

		measure 'Top Product by Revenue' = ```
				VAR TopProduct =
				    TOPN ( 1, ALL ( DimProduct[ProductName] ),
				           CALCULATE ( [Total Sales] ), DESC )
				RETURN
				    CONCATENATEX ( TopProduct, DimProduct[ProductName], ", " )
				```
			displayFolder: 03 Ranking

		measure 'Product Rank by Units' = ```
				RANKX ( ALL ( DimProduct[ProductName] ), [Total Quantity], ,
				        DESC, DENSE )
				```
			formatString: #,0
			displayFolder: 03 Ranking

		measure 'Avg Sales per Line' = AVERAGE ( FactSales[SalesAmount] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 04 Category

		measure 'Avg Sales per Order' = ```
				DIVIDE ( [Total Sales],
				         DISTINCTCOUNT ( FactSales[SalesOrderNumber] ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 04 Category

		measure 'Avg Sales per Category' = AVERAGEX ( VALUES ( DimProduct[Category] ), [Total Sales] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 04 Category

		measure 'Category Share %' = ```
				DIVIDE ( [Total Sales],
				         CALCULATE ( [Total Sales], ALL ( DimProduct ) ) )
				```
			formatString: 0.00%
			displayFolder: 04 Category

		measure 'Electronics Sales' = CALCULATE ( [Total Sales], DimProduct[Category] = "Electronics" )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 05 CALCULATE

		measure 'Shipped Sales' = CALCULATE ( [Total Sales], FactSales[OrderStatus] = "Shipped" )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 05 CALCULATE

		measure 'Discounted Sales' = CALCULATE ( [Total Sales], FactSales[DiscountPct] > 0 )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 05 CALCULATE

		measure 'Sales All Products' = CALCULATE ( [Total Sales], ALL ( DimProduct ) )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 05 CALCULATE

		measure 'Pct of Total Sales' = ```
				DIVIDE ( [Total Sales],
				         CALCULATE ( [Total Sales], ALL ( DimProduct ),
				                                    ALL ( DimTerritory ) ) )
				```
			formatString: 0.00%
			displayFolder: 05 CALCULATE

		measure 'Category Revenue' = ```
				CALCULATE ( [Total Sales],
				            ALLEXCEPT ( DimProduct, DimProduct[Category] ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 05 CALCULATE

		measure 'Pct of Category Sales' = ```
				DIVIDE ( [Total Sales],
				         CALCULATE ( [Total Sales],
				             ALLEXCEPT ( DimProduct, DimProduct[Category] ) ) )
				```
			formatString: 0.00%
			displayFolder: 05 CALCULATE

		measure 'Pct of Selected Sales' = ```
				DIVIDE ( [Total Sales],
				         CALCULATE ( [Total Sales],
				             ALLSELECTED ( DimProduct[Category] ) ) )
				```
			formatString: 0.00%
			displayFolder: 05 CALCULATE

		measure 'Sales 2025 Override' = CALCULATE ( [Total Sales], DimDate[Year] = 2025 )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 05 CALCULATE

		measure 'Sales 2025 KeepFilters' = ```
				CALCULATE ( [Total Sales],
				            KEEPFILTERS ( DimDate[Year] = 2025 ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 05 CALCULATE

		measure 'Laptops or Mobiles Sales' = ```
				CALCULATE ( [Total Sales],
				    FILTER ( ALL ( DimProduct[Subcategory] ),
				             DimProduct[Subcategory] = "Laptops"
				          || DimProduct[Subcategory] = "Mobiles" ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 05 CALCULATE

		measure 'Sales by Customer Territory' = ```
				CALCULATE ( [Total Sales],
				    USERELATIONSHIP ( DimCustomer[TerritoryKey],
				                      DimTerritory[TerritoryKey] ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 05 CALCULATE

		measure 'Sales YTD' = TOTALYTD ( [Total Sales], DimDate[Date] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Sales QTD' = TOTALQTD ( [Total Sales], DimDate[Date] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Sales MTD' = TOTALMTD ( [Total Sales], DimDate[Date] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Sales FYTD' = TOTALYTD ( [Total Sales], DimDate[Date], "31/03" )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Sales PY' = ```
				CALCULATE ( [Total Sales],
				            SAMEPERIODLASTYEAR ( DimDate[Date] ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Sales PM' = ```
				CALCULATE ( [Total Sales],
				            DATEADD ( DimDate[Date], -1, MONTH ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Sales PQ' = ```
				CALCULATE ( [Total Sales],
				            DATEADD ( DimDate[Date], -1, QUARTER ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Sales PY YTD' = ```
				CALCULATE ( [Sales YTD],
				            SAMEPERIODLASTYEAR ( DimDate[Date] ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'YoY Growth' = ```
				VAR Cur = [Total Sales]
				VAR Prev = [Sales PY]
				RETURN
				    IF ( NOT ISBLANK ( Prev ), Cur - Prev )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'YoY Growth %' = DIVIDE ( [Total Sales] - [Sales PY], [Sales PY] )
			formatString: 0.00%
			displayFolder: 06 Time

		measure 'MoM Growth %' = DIVIDE ( [Total Sales] - [Sales PM], [Sales PM] )
			formatString: 0.00%
			displayFolder: 06 Time

		measure 'YoY Trend' = ```
				VAR G = [YoY Growth %]
				RETURN
				    SWITCH ( TRUE (),
				        ISBLANK ( G ), "No prior year",
				        G > 0.10,      "Strong growth",
				        G > 0,         "Growing",
				        G > -0.10,     "Slight decline",
				        "Sharp decline" )
				```
			displayFolder: 06 Time

		measure 'Sales Rolling 3M' = ```
				CALCULATE ( [Total Sales],
				    DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ),
				                    -3, MONTH ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Sales Rolling 12M' = ```
				CALCULATE ( [Total Sales],
				    DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ),
				                    -12, MONTH ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Sales Cumulative' = ```
				CALCULATE ( [Total Sales],
				    FILTER ( ALLSELECTED ( DimDate[Date] ),
				             DimDate[Date] <= MAX ( DimDate[Date] ) ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Sales 3M Moving Avg' = ```
				AVERAGEX (
				    DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ),
				                    -3, MONTH ),
				    CALCULATE ( [Total Sales] ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Category Revenue PY' = ```
				CALCULATE ( [Total Sales],
				    ALLEXCEPT ( DimProduct, DimProduct[Category] ),
				    SAMEPERIODLASTYEAR ( DimDate[Date] ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Electronics YoY %' = ```
				VAR Cur =
				    CALCULATE ( [Total Sales],
				                DimProduct[Category] = "Electronics" )
				VAR Prev =
				    CALCULATE ( [Total Sales],
				                DimProduct[Category] = "Electronics",
				                SAMEPERIODLASTYEAR ( DimDate[Date] ) )
				RETURN
				    DIVIDE ( Cur - Prev, Prev )
				```
			formatString: 0.00%
			displayFolder: 06 Time

		measure 'Best Month Sales' = ```
				MAXX ( VALUES ( DimDate[YearMonth] ),
				       CALCULATE ( [Total Sales] ) )
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: 06 Time

		measure 'Best Month Name' = ```
				VAR T = TOPN ( 1, VALUES ( DimDate[YearMonth] ),
				               CALCULATE ( [Total Sales] ), DESC )
				RETURN
				    CONCATENATEX ( T, DimDate[YearMonth], ", " )
				```
			displayFolder: 06 Time

		partition FactSales = m
			mode: import
			source = ```
					let
					    // 1. CONNECT ------------------------------------------------------------
					    Source = Csv.Document(
					        File.Contents("C:\Users\ROG\Desktop\Mtech Classwork\Visual analytics\Lab_QP1_QP2\data\FactSales_RAW.csv"),
					        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),

					    // 2. REMOVE the always-blank column -------------------------------------
					    RemovedBlankCol = Table.RemoveColumns(Promoted, {"Notes"}),

					    // 3. REMOVE duplicate rows ----------------------------------------------
					    RemovedDuplicates = Table.Distinct(RemovedBlankCol),

					    // 4. PARSE the mixed-format text date into a real date -------------------
					    //    Source has yyyy-MM-dd, dd-MM-yyyy and dd/MM/yyyy mixed together.
					    AddedOrderDate = Table.AddColumn(RemovedDuplicates, "OrderDate",
					        each let t = Text.Replace([OrderDateText], "/", "-"),
					                 p = Text.Split(t, "-")
					             in  if Text.Length(p{0}) = 4
					                 then #date(Number.FromText(p{0}), Number.FromText(p{1}),
					                            Number.FromText(p{2}))
					                 else #date(Number.FromText(p{2}), Number.FromText(p{1}),
					                            Number.FromText(p{0})),
					        type date),

					    // 5. STRIP the currency text into a decimal ------------------------------
					    AddedUnitPrice = Table.AddColumn(AddedOrderDate, "UnitPrice",
					        each Number.FromText(
					            Text.Trim(Text.Replace(Text.Replace([UnitPriceText], "Rs.", ""),
					                                   ",", ""))),
					        type number),

					    // 6. CLEAN the messy status text (trim + consistent casing) --------------
					    CleanedStatus = Table.TransformColumns(AddedUnitPrice,
					        {{"OrderStatus", each Text.Proper(Text.Trim(_)), type text}}),

					    // 7. SET data types ------------------------------------------------------
					    Typed = Table.TransformColumnTypes(CleanedStatus, {
					        {"SalesOrderNumber", type text},
					        {"ProductKey", Int64.Type},
					        {"CustomerKey", Int64.Type},
					        {"TerritoryKey", Int64.Type},
					        {"OrderQuantity", Int64.Type},
					        {"DiscountPct", type number},
					        {"SalesAmount", type number},
					        {"TotalCost", type number}}),

					    // 8. REMOVE rows with a missing quantity ---------------------------------
					    RemovedNullQty = Table.SelectRows(Typed,
					        each [OrderQuantity] <> null),

					    // 9. REMOVE negative-quantity data-entry errors --------------------------
					    RemovedNegative = Table.SelectRows(RemovedNullQty,
					        each [OrderQuantity] > 0),

					    // 10. FILL the missing SalesAmount from price x qty x (1 - discount) -----
					    FixedSalesAmount = Table.ReplaceValue(RemovedNegative,
					        each [SalesAmount],
					        each if [SalesAmount] = null
					             then Number.Round([UnitPrice] * [OrderQuantity]
					                               * (1 - [DiscountPct]), 2)
					             else [SalesAmount],
					        Replacer.ReplaceValue, {"SalesAmount"}),

					    // 11. EXCLUDE cancelled orders from the sales analysis --------------------
					    RemovedCancelled = Table.SelectRows(FixedSalesAmount,
					        each [OrderStatus] <> "Cancelled"),

					    // 12. ADD a Profit column ------------------------------------------------
					    AddedProfit = Table.AddColumn(RemovedCancelled, "Profit",
					        each [SalesAmount] - [TotalCost], type number),

					    // 13. ADD the DateKey used to join DimDate -------------------------------
					    AddedDateKey = Table.AddColumn(AddedProfit, "DateKey",
					        each Date.Year([OrderDate]) * 10000
					           + Date.Month([OrderDate]) * 100
					           + Date.Day([OrderDate]), Int64.Type),

					    // 14. DROP the now-redundant raw text columns ----------------------------
					    RemovedRawText = Table.RemoveColumns(AddedDateKey,
					        {"OrderDateText", "UnitPriceText"}),

					    // 15. REORDER for readability --------------------------------------------
					    Reordered = Table.ReorderColumns(RemovedRawText, {
					        "SalesOrderNumber", "OrderDate", "DateKey", "ProductKey",
					        "CustomerKey", "TerritoryKey", "OrderQuantity", "UnitPrice",
					        "DiscountPct", "SalesAmount", "TotalCost", "Profit", "OrderStatus"})
					in
					    Reordered
					```

	table DimProduct

		column ProductKey
			dataType: int64
			sourceColumn: ProductKey
			summarizeBy: none
			isHidden

		column Category
			dataType: string
			sourceColumn: Category
			summarizeBy: none

		column Subcategory
			dataType: string
			sourceColumn: Subcategory
			summarizeBy: none

		column ProductName
			dataType: string
			sourceColumn: ProductName
			summarizeBy: none

		column StandardCost
			dataType: double
			sourceColumn: StandardCost
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			summarizeBy: none

		column ListPrice
			dataType: double
			sourceColumn: ListPrice
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			summarizeBy: none

		column SKU
			dataType: string
			sourceColumn: SKU
			summarizeBy: none

		column UnitMargin
			dataType: double
			sourceColumn: UnitMargin
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			summarizeBy: none

		column 'Price Tier' = ```
				SWITCH ( TRUE (),
				    DimProduct[ListPrice] < 100, "Budget",
				    DimProduct[ListPrice] < 500, "Mid-range",
				    "Premium" )
				```
			summarizeBy: none

		hierarchy 'Product Hierarchy'
			level Category
				column: Category

			level Subcategory
				column: Subcategory

			level ProductName
				column: ProductName

		partition DimProduct = m
			mode: import
			source = ```
					let
					    Source = Csv.Document(File.Contents("C:\Users\ROG\Desktop\Mtech Classwork\Visual analytics\Lab_QP1_QP2\data\DimProduct.csv"),
					        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					    Typed = Table.TransformColumnTypes(Promoted, {
					        {"ProductKey", Int64.Type}, {"Category", type text},
					        {"Subcategory", type text}, {"ProductName", type text},
					        {"StandardCost", type number}, {"ListPrice", type number},
					        {"SKU", type text}}),
					    Trimmed = Table.TransformColumns(Typed, {
					        {"Category", Text.Trim, type text},
					        {"Subcategory", Text.Trim, type text},
					        {"ProductName", Text.Trim, type text}}),
					    AddedMargin = Table.AddColumn(Trimmed, "UnitMargin",
					        each [ListPrice] - [StandardCost], type number)
					in
					    AddedMargin
					```

	table DimCustomer

		column CustomerKey
			dataType: int64
			sourceColumn: CustomerKey
			summarizeBy: none
			isHidden

		column Segment
			dataType: string
			sourceColumn: Segment
			summarizeBy: none

		column TerritoryKey
			dataType: int64
			sourceColumn: TerritoryKey
			summarizeBy: none
			isHidden

		column CustomerName
			dataType: string
			sourceColumn: CustomerName
			summarizeBy: none

		hierarchy 'Customer Hierarchy'
			level Segment
				column: Segment

			level CustomerName
				column: CustomerName

		partition DimCustomer = m
			mode: import
			source = ```
					let
					    Source = Csv.Document(File.Contents("C:\Users\ROG\Desktop\Mtech Classwork\Visual analytics\Lab_QP1_QP2\data\DimCustomer.csv"),
					        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					    Typed = Table.TransformColumnTypes(Promoted, {
					        {"CustomerKey", Int64.Type}, {"Segment", type text},
					        {"TerritoryKey", Int64.Type}, {"CustomerName", type text}})
					in
					    Typed
					```

	table DimTerritory

		column TerritoryKey
			dataType: int64
			sourceColumn: TerritoryKey
			summarizeBy: none
			isHidden

		column Region
			dataType: string
			sourceColumn: Region
			summarizeBy: none

		column Country
			dataType: string
			sourceColumn: Country
			summarizeBy: none

		column Group
			dataType: string
			sourceColumn: Group
			summarizeBy: none

		hierarchy 'Geography Hierarchy'
			level Group
				column: Group

			level Country
				column: Country

			level Region
				column: Region

		partition DimTerritory = m
			mode: import
			source = ```
					let
					    Source = Csv.Document(File.Contents("C:\Users\ROG\Desktop\Mtech Classwork\Visual analytics\Lab_QP1_QP2\data\DimTerritory.csv"),
					        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					    Typed = Table.TransformColumnTypes(Promoted, {
					        {"TerritoryKey", Int64.Type}, {"Region", type text},
					        {"Country", type text}, {"Group", type text}})
					in
					    Typed
					```

	table DimDate
		dataCategory: Time

		column DateKey
			dataType: int64
			sourceColumn: DateKey
			summarizeBy: none
			isHidden

		column Date
			dataType: dateTime
			sourceColumn: Date
			formatString: dd mmm yyyy
			summarizeBy: none
			isKey

		column Year
			dataType: int64
			sourceColumn: Year
			summarizeBy: none

		column QuarterNo
			dataType: int64
			sourceColumn: QuarterNo
			summarizeBy: none
			isHidden

		column Quarter
			dataType: string
			sourceColumn: Quarter
			summarizeBy: none
			sortByColumn: QuarterNo

		column MonthNo
			dataType: int64
			sourceColumn: MonthNo
			summarizeBy: none
			isHidden

		column MonthName
			dataType: string
			sourceColumn: MonthName
			summarizeBy: none
			sortByColumn: MonthNo

		column MonthShort
			dataType: string
			sourceColumn: MonthShort
			summarizeBy: none
			sortByColumn: MonthNo

		column YearMonth
			dataType: string
			sourceColumn: YearMonth
			summarizeBy: none

		column WeekOfYear
			dataType: int64
			sourceColumn: WeekOfYear
			summarizeBy: none

		column DayOfMonth
			dataType: int64
			sourceColumn: DayOfMonth
			summarizeBy: none

		column DayName
			dataType: string
			sourceColumn: DayName
			summarizeBy: none

		column IsWeekend
			dataType: boolean
			sourceColumn: IsWeekend
			summarizeBy: none

		column 'Financial Year' = ```
				"FY " & IF ( DimDate[MonthNo] >= 4, DimDate[Year],
				                DimDate[Year] - 1 )
				       & "-" & RIGHT ( IF ( DimDate[MonthNo] >= 4,
				                DimDate[Year] + 1, DimDate[Year] ), 2 )
				```
			summarizeBy: none

		hierarchy 'Date Hierarchy'
			level Year
				column: Year

			level Quarter
				column: Quarter

			level MonthName
				column: MonthName

			level DayOfMonth
				column: DayOfMonth

		partition DimDate = m
			mode: import
			source = ```
					let
					    Source = Csv.Document(File.Contents("C:\Users\ROG\Desktop\Mtech Classwork\Visual analytics\Lab_QP1_QP2\data\DimDate.csv"),
					        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					    Typed = Table.TransformColumnTypes(Promoted, {
					        {"DateKey", Int64.Type}, {"Date", type date}, {"Year", Int64.Type},
					        {"QuarterNo", Int64.Type}, {"Quarter", type text},
					        {"MonthNo", Int64.Type}, {"MonthName", type text},
					        {"MonthShort", type text}, {"YearMonth", type text},
					        {"WeekOfYear", Int64.Type}, {"DayOfMonth", Int64.Type},
					        {"DayName", type text}, {"IsWeekend", type logical}})
					in
					    Typed
					```

	relationship rel_Date_Fact
		fromColumn: FactSales.DateKey
		toColumn: DimDate.DateKey

	relationship rel_Product_Fact
		fromColumn: FactSales.ProductKey
		toColumn: DimProduct.ProductKey

	relationship rel_Customer_Fact
		fromColumn: FactSales.CustomerKey
		toColumn: DimCustomer.CustomerKey

	relationship rel_Territory_Fact
		fromColumn: FactSales.TerritoryKey
		toColumn: DimTerritory.TerritoryKey

	relationship rel_Territory_Customer
		isActive: false
		fromColumn: DimCustomer.TerritoryKey
		toColumn: DimTerritory.TerritoryKey
