		sourceColumn: [Total Sales]

	column 'Total Quantity'
		lineageTag: 40befbdb-8780-444d-90dd-c93116c1e221
		isNameInferred
		sourceColumn: [Total Quantity]

	column 'Order Count'
		lineageTag: 0292d8fb-ead2-4c1f-90d4-6d85aebbffe3
