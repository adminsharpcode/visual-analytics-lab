	column 'Avg Sales per Order'
		lineageTag: 75c5ce82-a94e-4259-a165-acce68024fc3
		isNameInferred
		sourceColumn: [Avg Sales per Order]

	partition 'Product Category Summary' = calculated
		mode: import
		source =
				SUMMARIZE (
				    FactSales,
				    DimProduct[Category],
				    "Total Sales",         [Total Sales],
				    "Total Quantity",      [Total Quantity],
				    "Order Count",         [Order Count],
				    "Avg Sales per Order", [Avg Sales per Order]
				)

