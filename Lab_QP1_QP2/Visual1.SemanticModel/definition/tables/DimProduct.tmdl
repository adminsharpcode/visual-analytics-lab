table DimProduct
	lineageTag: de61f3fb-de49-464a-aed2-e26f86897593

	column ProductKey
		dataType: int64
		isHidden
		lineageTag: 2cb41a08-c4d4-4508-868a-33c1ee71cfea
		summarizeBy: none
		sourceColumn: ProductKey

	column Category
		dataType: string
		lineageTag: ce615db3-aae2-40d2-a362-373eb10d7a48
		summarizeBy: none
		sourceColumn: Category

	column Subcategory
		dataType: string
		lineageTag: 56df90c5-bdfe-4f65-9b24-a3ec971160f9
		summarizeBy: none
		sourceColumn: Subcategory

	column ProductName
		dataType: string
		lineageTag: 52fd9ee0-2577-42db-bb44-948ae523c6da
		summarizeBy: none
		sourceColumn: ProductName

	column StandardCost
		dataType: double
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c5bd0fca-e22d-4b0b-ba0c-ea74aa157327
		summarizeBy: none
		sourceColumn: StandardCost

	column ListPrice
		dataType: double
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 63152777-288a-4f31-8087-a9f9e7081bb4
		summarizeBy: none
		sourceColumn: ListPrice

	column SKU
		dataType: string
		lineageTag: 13c496d6-c860-4e9e-8eb1-25852020bf9c
		summarizeBy: none
		sourceColumn: SKU

	column UnitMargin
		dataType: double
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d46716f7-34b4-4983-9ce6-2770261bb582
		summarizeBy: none
		sourceColumn: UnitMargin

	column 'Price Tier' =
			SWITCH ( TRUE (),
			    DimProduct[ListPrice] < 100, "Budget",
			    DimProduct[ListPrice] < 500, "Mid-range",
			    "Premium" )
		lineageTag: f6722f65-48e1-4fe1-ad55-ea032d593183
		summarizeBy: none

	hierarchy 'Product Hierarchy'
		lineageTag: 82271d22-d8a6-43eb-992a-74f3d82becf3

		level Category
			lineageTag: 5578c69f-5427-49ad-9fdf-55bf98237516
			column: Category

		level Subcategory
			lineageTag: 28739cfc-4f43-44bd-a7d9-0410faf4ef42
			column: Subcategory

		level ProductName
			lineageTag: 3e936d14-4428-4fd1-8ea3-9842d9d50729
			column: ProductName

	partition DimProduct = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\ROG\Desktop\Mtech Classwork\Visual analytics\Lab_QP1_QP2\data\DimProduct.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"ProductKey", Int64.Type}, {"Category", type text},
				        {"Subcategory", type text}, {"ProductName", type text},
				        {"StandardCost", type number}, {"ListPrice", type number},
				        {"SKU", type text}}),
				    Trimmed = Table.TransformColumns(Typed, {
				        {"Category", Text.Trim, type text},
				        {"Subcategory", Text.Trim, type text},
				        {"ProductName", Text.Trim, type text}}),
				    AddedMargin = Table.AddColumn(Trimmed, "UnitMargin",
				        each [ListPrice] - [StandardCost], type number)
				in
				    AddedMargin

