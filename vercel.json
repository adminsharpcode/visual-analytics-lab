{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/Project_SmartEnergy_PowerBI/web_dashboard/index.html" },
    { "source": "/:match*", "destination": "/Project_SmartEnergy_PowerBI/web_dashboard/:match*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
