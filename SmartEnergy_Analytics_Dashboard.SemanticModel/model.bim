{
  "name": "SmartEnergy_Analytics_Model",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Fact_EnergyConsumption",
        "columns": [
          {
            "name": "Timestamp",
            "dataType": "dateTime",
            "sourceColumn": "Timestamp",
            "summarizeBy": "none"
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none"
          },
          {
            "name": "Hour",
            "dataType": "int64",
            "sourceColumn": "Hour",
            "summarizeBy": "none"
          },
          {
            "name": "FacilityID",
            "dataType": "string",
            "sourceColumn": "FacilityID",
            "summarizeBy": "none"
          },
          {
            "name": "TariffID",
            "dataType": "string",
            "sourceColumn": "TariffID",
            "summarizeBy": "none"
          },
          {
            "name": "ActivePower_kWh",
            "dataType": "double",
            "sourceColumn": "ActivePower_kWh",
            "summarizeBy": "sum",
            "formatString": "#,0.00"
          },
          {
            "name": "ReactivePower_kVARh",
            "dataType": "double",
            "sourceColumn": "ReactivePower_kVARh",
            "summarizeBy": "sum",
            "formatString": "#,0.00"
          },
          {
            "name": "PowerFactor",
            "dataType": "double",
            "sourceColumn": "PowerFactor",
            "summarizeBy": "average",
            "formatString": "#,0.00"
          },
          {
            "name": "Voltage_V",
            "dataType": "double",
            "sourceColumn": "Voltage_V",
            "summarizeBy": "average",
            "formatString": "#,0.00"
          },
          {
            "name": "TariffBand",
            "dataType": "string",
            "sourceColumn": "TariffBand",
            "summarizeBy": "none"
          },
          {
            "name": "PeakPeriodFlag",
            "dataType": "int64",
            "sourceColumn": "PeakPeriodFlag",
            "summarizeBy": "none"
          },
          {
            "name": "SolarGeneration_kWh",
            "dataType": "double",
            "sourceColumn": "SolarGeneration_kWh",
            "summarizeBy": "sum",
            "formatString": "#,0.00"
          },
          {
            "name": "NetGridImport_kWh",
            "dataType": "double",
            "sourceColumn": "NetGridImport_kWh",
            "summarizeBy": "sum",
            "formatString": "#,0.00"
          },
          {
            "name": "Cost_INR",
            "dataType": "double",
            "sourceColumn": "Cost_INR",
            "summarizeBy": "sum",
            "formatString": "\\\u20b9#,0.00;(\\\u20b9#,0.00);\\\u20b9#,0.00"
          },
          {
            "name": "CarbonEmission_kgCO2",
            "dataType": "double",
            "sourceColumn": "CarbonEmission_kgCO2",
            "summarizeBy": "sum",
            "formatString": "#,0.00"
          },
          {
            "name": "AnomalyFlag",
            "dataType": "int64",
            "sourceColumn": "AnomalyFlag",
            "summarizeBy": "none"
          },
          {
            "name": "AnomalyType",
            "dataType": "string",
            "sourceColumn": "AnomalyType",
            "summarizeBy": "none"
          },
          {
            "name": "Carbon_kgCO2",
            "dataType": "double",
            "sourceColumn": "Carbon_kgCO2",
            "summarizeBy": "sum",
            "formatString": "#,0.00"
          },
          {
            "name": "NetImport_kWh",
            "dataType": "double",
            "sourceColumn": "NetImport_kWh",
            "summarizeBy": "sum",
            "formatString": "#,0.00"
          },
          {
            "name": "SolarSelfConsumptionRatio",
            "dataType": "double",
            "sourceColumn": "SolarSelfConsumptionRatio",
            "summarizeBy": "average",
            "formatString": "0.0%"
          }
        ],
        "partitions": [
          {
            "name": "Fact_EnergyConsumption",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:/Users/ROG/Desktop/Mtech Classwork/Visual analytics/Project_SmartEnergy_PowerBI/data/Fact_EnergyConsumption.csv\"), [Delimiter=\",\", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {{\"Timestamp\", type datetime}, {\"Date\", type date}, {\"Hour\", Int64.Type}, {\"FacilityID\", type text}, {\"TariffID\", type text}, {\"ActivePower_kWh\", type number}, {\"ReactivePower_kVARh\", type number}, {\"PowerFactor\", type number}, {\"Voltage_V\", type number}, {\"TariffBand\", type text}, {\"PeakPeriodFlag\", Int64.Type}, {\"SolarGeneration_kWh\", type number}, {\"NetGridImport_kWh\", type number}, {\"Cost_INR\", type number}, {\"CarbonEmission_kgCO2\", type number}, {\"AnomalyFlag\", Int64.Type}, {\"AnomalyType\", type text}, {\"Carbon_kgCO2\", type number}, {\"NetImport_kWh\", type number}, {\"SolarSelfConsumptionRatio\", type number}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Active Consumption (GWh)",
            "expression": "DIVIDE(SUM(Fact_EnergyConsumption[ActivePower_kWh]), 1000000)",
            "formatString": "#,0.00",
            "displayFolder": "01 Executive KPIs",
            "description": "Total electrical energy consumed across metered facilities in GWh"
          },
          {
            "name": "Total Electricity Spend (Cr)",
            "expression": "DIVIDE(SUM(Fact_EnergyConsumption[Cost_INR]), 10000000)",
            "formatString": "\\\u20b9#,0.00;(\\\u20b9#,0.00);\\\u20b9#,0.00",
            "displayFolder": "01 Executive KPIs",
            "description": "Total expenditure incurred on electrical utilities in Crores INR"
          },
          {
            "name": "Total Solar Generation (GWh)",
            "expression": "DIVIDE(SUM(Fact_EnergyConsumption[SolarGeneration_kWh]), 1000000)",
            "formatString": "#,0.00",
            "displayFolder": "01 Executive KPIs",
            "description": "Clean solar electricity generated by on-campus rooftop PV in GWh"
          },
          {
            "name": "Solar Penetration %",
            "expression": "DIVIDE(SUM(Fact_EnergyConsumption[SolarGeneration_kWh]), SUM(Fact_EnergyConsumption[ActivePower_kWh]), 0)",
            "formatString": "0.0%",
            "displayFolder": "01 Executive KPIs",
            "description": "Percentage of gross consumption self-supplied by solar PV"
          },
          {
            "name": "Campus Peak Demand (kW)",
            "expression": "MAXX(VALUES(Fact_EnergyConsumption[Timestamp]), CALCULATE(SUM(Fact_EnergyConsumption[ActivePower_kWh])))",
            "formatString": "#,0.00",
            "displayFolder": "01 Executive KPIs",
            "description": "Highest coincident aggregate power demand observed in kW"
          },
          {
            "name": "Carbon Footprint (tCO2e)",
            "expression": "DIVIDE(SUM(Fact_EnergyConsumption[Carbon_kgCO2]), 1000)",
            "formatString": "#,0.00",
            "displayFolder": "01 Executive KPIs",
            "description": "Scope 2 grid emissions computed via CEA grid emissions factor (0.82 kgCO2/kWh)"
          },
          {
            "name": "Clean Energy Offset (tCO2e)",
            "expression": "DIVIDE(SUM(Fact_EnergyConsumption[SolarGeneration_kWh]) * 0.82, 1000)",
            "formatString": "#,0.00",
            "displayFolder": "01 Executive KPIs",
            "description": "Avoided carbon emissions due to on-site solar offset"
          },
          {
            "name": "Total Ingested Meter Records",
            "expression": "COUNTROWS(Fact_EnergyConsumption)",
            "formatString": "#,0",
            "displayFolder": "01 Executive KPIs",
            "description": "Total hourly metered telemetry readings in warehouse"
          },
          {
            "name": "Average Energy Star Rating",
            "expression": "AVERAGE(Dim_Facility[EnergyStarRating])",
            "formatString": "#,0.00",
            "displayFolder": "02 Benchmarking",
            "description": "Campus-wide average facility Energy Star performance score"
          },
          {
            "name": "Energy Use Intensity (EUI)",
            "expression": "DIVIDE(SUM(Fact_EnergyConsumption[ActivePower_kWh]), SUM(Dim_Facility[Area_SqFt]), 0)",
            "formatString": "#,0.00",
            "displayFolder": "02 Benchmarking",
            "description": "Annual active power consumption normalized by floor area (kWh/sq.ft)"
          },
          {
            "name": "Blended Cost per kWh",
            "expression": "DIVIDE(SUM(Fact_EnergyConsumption[Cost_INR]), SUM(Fact_EnergyConsumption[ActivePower_kWh]), 0)",
            "formatString": "\\\u20b9#,0.00;(\\\u20b9#,0.00);\\\u20b9#,0.00",
            "displayFolder": "02 Benchmarking",
            "description": "Effective blended utility tariff rate in INR per kWh"
          },
          {
            "name": "Average Power Factor",
            "expression": "AVERAGE(Fact_EnergyConsumption[PowerFactor])",
            "formatString": "#,0.00",
            "displayFolder": "02 Benchmarking",
            "description": "Displacement and distortion power factor efficiency index"
          },
          {
            "name": "Net Grid Utility Import (GWh)",
            "expression": "DIVIDE(SUM(Fact_EnergyConsumption[NetImport_kWh]), 1000000)",
            "formatString": "#,0.00",
            "displayFolder": "02 Benchmarking",
            "description": "Electricity drawn from external DISCOM grid after solar offset"
          },
          {
            "name": "Anomaly Event Count",
            "expression": "CALCULATE(COUNTROWS(Fact_EnergyConsumption), Fact_EnergyConsumption[AnomalyFlag] = 1)",
            "formatString": "#,0",
            "displayFolder": "03 Anomaly Analytics",
            "description": "Count of statistical breaches beyond Shewhart 3-sigma limits"
          },
          {
            "name": "Anomaly Breach Rate %",
            "expression": "DIVIDE([AnomalyEventCount], [Total Ingested Meter Records], 0)",
            "formatString": "0.0%",
            "displayFolder": "03 Anomaly Analytics",
            "description": "Operational anomaly incidence rate"
          },
          {
            "name": "Wasted Anomaly Cost (INR)",
            "expression": "SUM(Fact_Anomalies_Detailed[WastedCost_INR])",
            "formatString": "\\\u20b9#,0.00;(\\\u20b9#,0.00);\\\u20b9#,0.00",
            "displayFolder": "03 Anomaly Analytics",
            "description": "Direct financial waste attributable to equipment faults and chiller overrides"
          },
          {
            "name": "Excess Unscheduled Load (kWh)",
            "expression": "SUM(Fact_Anomalies_Detailed[Excess_kWh])",
            "formatString": "#,0.00",
            "displayFolder": "03 Anomaly Analytics",
            "description": "Total excess kWh consumed during equipment anomaly windows"
          },
          {
            "name": "Peak Period Consumption (GWh)",
            "expression": "CALCULATE([Total Active Consumption (GWh)], Dim_Time[PeakTariffFlag] = 1)",
            "formatString": "#,0.00",
            "displayFolder": "04 Tariff Analytics",
            "description": "Consumption during peak utility tariff band (17:00-22:00)"
          },
          {
            "name": "Off-Peak Consumption (GWh)",
            "expression": "CALCULATE([Total Active Consumption (GWh)], Dim_Time[PeakTariffFlag] = 0)",
            "formatString": "#,0.00",
            "displayFolder": "04 Tariff Analytics",
            "description": "Consumption during shoulder and off-peak tariff bands"
          },
          {
            "name": "Peak Tariff Spend (Cr)",
            "expression": "CALCULATE([Total Electricity Spend (Cr)], Dim_Time[PeakTariffFlag] = 1)",
            "formatString": "\\\u20b9#,0.00;(\\\u20b9#,0.00);\\\u20b9#,0.00",
            "displayFolder": "04 Tariff Analytics",
            "description": "Expenditure during premium peak rate window"
          },
          {
            "name": "Solar Peak Coincidence Ratio",
            "expression": "DIVIDE(CALCULATE(SUM(Fact_EnergyConsumption[SolarGeneration_kWh]), Dim_Time[Hour] >= 11 && Dim_Time[Hour] <= 15), CALCULATE(SUM(Fact_EnergyConsumption[ActivePower_kWh]), Dim_Time[Hour] >= 11 && Dim_Time[Hour] <= 15), 0)",
            "formatString": "0.0%",
            "displayFolder": "04 Tariff Analytics",
            "description": "Midday solar offset coverage during cooling peak"
          },
          {
            "name": "Consumption PY (GWh)",
            "expression": "CALCULATE([Total Active Consumption (GWh)], SAMEPERIODLASTYEAR(Dim_Date[Date]))",
            "formatString": "#,0.00",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Consumption YoY Growth %",
            "expression": "DIVIDE([Total Active Consumption (GWh)] - [Consumption PY (GWh)], [Consumption PY (GWh)], 0)",
            "formatString": "0.0%",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Consumption MTD (GWh)",
            "expression": "TOTALMTD([Total Active Consumption (GWh)], Dim_Date[Date])",
            "formatString": "#,0.00",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Consumption QTD (GWh)",
            "expression": "TOTALQTD([Total Active Consumption (GWh)], Dim_Date[Date])",
            "formatString": "#,0.00",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Forecast Projected Demand (kWh)",
            "expression": "SUM(Fact_DemandForecast[Forecast_kWh])",
            "formatString": "#,0.00",
            "displayFolder": "05 Time Intelligence",
            "description": "Prophet/Ridge machine learning 30-day projected trajectory"
          }
        ]
      },
