		lineageTag: b7352c00-bdd5-4e1b-b4a5-872e255faeed

	column Type
		dataType: string
		summarizeBy: none
		sourceColumn: Type
		lineageTag: abef5459-41e0-49d1-85cc-719b4767404d

	column Actual_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
