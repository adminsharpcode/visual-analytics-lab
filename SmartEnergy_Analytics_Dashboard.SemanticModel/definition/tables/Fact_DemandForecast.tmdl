table Fact_DemandForecast
	lineageTag: 72484c1e-21e5-49c3-b47b-04061702cab0

	measure 'Forecast Projected Demand (kWh)' = SUM(Fact_DemandForecast[Forecast_kWh])
		formatString: #,0.0
		lineageTag: 7b858d89-b713-4f45-bb06-a7d24f2d09cd

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date
		lineageTag: 2023d825-8903-437b-bdb7-50052783c7b9

	column Type
		dataType: string
		summarizeBy: none
		sourceColumn: Type
		lineageTag: aa2ee9b5-2b45-405d-997a-a3db3c7a7443

	column Actual_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Actual_kWh
		lineageTag: 99942e1f-7d80-4c81-af88-13e06c4a8fc9

	column Forecast_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Forecast_kWh
		lineageTag: 0c6f3b08-e3d3-4f41-9291-18f803eca564

	column Lower95_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Lower95_kWh
		lineageTag: 5e78d547-17a4-4edd-957c-feee6a636104

	column Upper95_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Upper95_kWh
		lineageTag: 8eb5f6ea-8c7d-4ba5-9e7e-b07673cf1b8e

	partition Fact_DemandForecast = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("C:/Users/ROG/Desktop/Mtech Classwork/Visual analytics/Project_SmartEnergy_PowerBI/data/Fact_DemandForecast.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"Date", type date}, {"Type", type text}, {"Actual_kWh", type number}, {"Forecast_kWh", type number}, {"Lower95_kWh", type number}, {"Upper95_kWh", type number}
			    })
			in
			    Typed
