table Fact_DemandForecast
	lineageTag: 04b80f7e-96c6-4a53-8b51-a896aaa76df8

	measure 'Forecast Projected Demand (kWh)' = SUM(Fact_DemandForecast[Forecast_kWh])
		formatString: #,0.0
		lineageTag: 0b67ac86-3789-4771-b55f-8ce0cd423f50

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date
		lineageTag: 8650dc6d-34b8-425d-ad0d-747deaa87f7a

	column Type
		dataType: string
		summarizeBy: none
		sourceColumn: Type
		lineageTag: da2e1925-8d31-4b84-9b4e-d8c1935fe49c

	column Actual_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Actual_kWh
		lineageTag: 59a4b8a1-98a4-4c10-a167-a4455dc0d255

	column Forecast_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Forecast_kWh
		lineageTag: c4876bab-9582-4234-a4e4-b86f6558f90c

	column Lower95_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Lower95_kWh
		lineageTag: 8d893aca-f7c8-4928-a7c0-3e14848a0ff6

	column Upper95_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Upper95_kWh
		lineageTag: da5955ab-dec9-4ff9-874e-0fcb71244753

	partition Fact_DemandForecast = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("C:/Users/ROG/Desktop/Mtech Classwork/Visual analytics/Project_SmartEnergy_PowerBI/data/Fact_DemandForecast.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"Date", type date}, {"Type", type text}, {"Actual_kWh", type number}, {"Forecast_kWh", type number}, {"Lower95_kWh", type number}, {"Upper95_kWh", type number}
			    })
			in
			    Typed
