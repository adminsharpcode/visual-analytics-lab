table Fact_DemandForecast
	lineageTag: aad89581-1381-4672-bac6-46976ad7eb59

	measure 'Forecast Projected Demand (kWh)' = SUM(Fact_DemandForecast[Forecast_kWh])
		formatString: #,0.0
		lineageTag: 49fdd16a-9aa0-4590-8b98-917bf1ad2245

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date
		lineageTag: 0521853f-6551-4bf4-8ac9-298e90158b92

	column Type
		dataType: string
		summarizeBy: none
		sourceColumn: Type
		lineageTag: 4dc70025-1c3a-4afd-ae6a-10ba6d5595c6

	column Actual_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Actual_kWh
		lineageTag: 10c33442-0bc6-4a90-869e-67c213664876

	column Forecast_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Forecast_kWh
		lineageTag: d69111c7-1831-453f-a531-e1e1d8c4d4cd

	column Lower95_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Lower95_kWh
		lineageTag: 77c05b53-24ed-4f88-9acd-48128fd6f804

	column Upper95_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Upper95_kWh
		lineageTag: 6d7ab420-50b8-4f03-a1bb-cf495e216bb7

	partition Fact_DemandForecast = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("C:/Users/ROG/Desktop/Mtech Classwork/Visual analytics/Project_SmartEnergy_PowerBI/data/Fact_DemandForecast.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"Date", type date}, {"Type", type text}, {"Actual_kWh", type number}, {"Forecast_kWh", type number}, {"Lower95_kWh", type number}, {"Upper95_kWh", type number}
			    })
			in
			    Typed
