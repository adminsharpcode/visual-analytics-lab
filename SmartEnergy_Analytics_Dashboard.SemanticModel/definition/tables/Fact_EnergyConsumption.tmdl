	partition Fact_EnergyConsumption = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("C:/Users/ROG/Desktop/Mtech Classwork/Visual analytics/Project_SmartEnergy_PowerBI/data/Fact_EnergyConsumption.csv"), [Delimiter=",", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"Timestamp", type datetime}, {"Date", type date}, {"Hour", Int64.Type}, {"FacilityID", type text},
			        {"TariffID", type text}, {"ActivePower_kWh", type number}, {"ReactivePower_kVARh", type number},
			        {"PowerFactor", type number}, {"Voltage_V", type number}, {"TariffBand", type text},
			        {"PeakPeriodFlag", Int64.Type}, {"SolarGeneration_kWh", type number}, {"NetGridImport_kWh", type number},
			        {"Cost_INR", type number}, {"CarbonEmission_kgCO2", type number}, {"AnomalyFlag", Int64.Type},
			        {"AnomalyType", type text}, {"Carbon_kgCO2", type number}, {"NetImport_kWh", type number},
			        {"SolarSelfConsumptionRatio", type number}
			    })
			in
			    Typed
