		sourceColumn: HeatingDegreeHours
		lineageTag: 6c8bfc86-f1b8-4ad5-943b-3373203ccd8d

	partition Dim_Weather = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("C:/Users/ROG/Desktop/Mtech Classwork/Visual analytics/Project_SmartEnergy_PowerBI/data/Dim_Weather.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.None]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"Date", type date}, {"Hour", Int64.Type}, {"AmbientTemp_C", type number}, {"Humidity_Pct", type number},
			        {"SolarIrradiance_W_m2", type number}, {"CoolingDegreeHours", type number}, {"HeatingDegreeHours", type number}
			    })
			in
			    Typed
