	partition Fact_Anomalies_Detailed = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("C:/Users/ROG/Desktop/Mtech Classwork/Visual analytics/Project_SmartEnergy_PowerBI/data/Fact_Anomalies_Detailed.csv"), [Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"Timestamp", type datetime}, {"FacilityID", type text}, {"ActivePower_kWh", type number},
			        {"RollingMean_kWh", type number}, {"RollingStd_kWh", type number}, {"UpperLimit_kWh", type number},
			        {"Excess_kWh", type number}, {"WastedCost_INR", type number}, {"AnomalyType", type text}, {"Severity", type text}
			    })
			in
			    Typed
