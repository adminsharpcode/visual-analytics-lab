# Visual Analytics Lab (MACSE603) - Assessment 8 (Experiment 14)
# Student: Vedant Nimkar | Reg No: 26MML0045
# Streamlit Multipage Analytics Dashboard Container
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="Vedant Nimkar <26MML0045@vitstudent.ac.in>"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY streamlit_app/ .
COPY data/ ./data/

EXPOSE 8501

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

ENTRYPOINT ["streamlit", "run", "Home.py", "--server.port=8501", "--server.address=0.0.0.0"]
