model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

annotation PBI_QueryOrder = ["FactSales","DimProduct","DimCustomer","DimTerritory","DimDate"]

ref table FactSales
ref table DimProduct
ref table DimCustomer
ref table DimTerritory
ref table DimDate
ref table 'Product Category Summary'
ref table 'Top 5 Products'

ref cultureInfo en-US

