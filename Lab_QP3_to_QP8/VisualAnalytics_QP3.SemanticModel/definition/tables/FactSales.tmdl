	measure 'YoY Growth' =
			VAR Cur = [Total Sales]
			VAR Prev = [Sales PY]
			RETURN
			    IF ( NOT ISBLANK ( Prev ), Cur - Prev )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 06 Time
		lineageTag: 20c5752c-0f3b-4b14-a52a-d674022f0029

	measure 'YoY Growth %' = DIVIDE ( [Total Sales] - [Sales PY], [Sales PY] )
		formatString: 0.00%
		displayFolder: 06 Time
		lineageTag: b935fce6-9761-47ee-83ed-387179e83bcb

	measure 'MoM Growth %' = DIVIDE ( [Total Sales] - [Sales PM], [Sales PM] )
		formatString: 0.00%
		displayFolder: 06 Time
		lineageTag: 260d09a1-4d96-450b-8048-717ba04d1c4c

	measure 'YoY Trend' =
			VAR G = [YoY Growth %]
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( G ), "No prior year",
			        G > 0.10,      "Strong growth",
			        G > 0,         "Growing",
			        G > -0.10,     "Slight decline",
			        "Sharp decline" )
		displayFolder: 06 Time
		lineageTag: 82a2cb23-1e16-41c8-81b0-2325920f6fb8

	measure 'Sales Rolling 3M' =
			CALCULATE ( [Total Sales],
