table FactSales
	lineageTag: 3124ffbc-e578-40a6-a17c-23c845a6fbc3

	measure 'Total Sales' = SUM ( FactSales[SalesAmount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 01 Sales
		lineageTag: 3fc50a96-ab57-434e-8db9-9cf986b6024e

	measure 'Total Quantity' = SUM ( FactSales[OrderQuantity] )
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: cbd2387c-8800-405d-926b-43a4bece00a2

	measure 'Total Cost' = SUM ( FactSales[TotalCost] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 02 Profit
		lineageTag: f3041a36-634e-43e6-9230-8abd618b52e8

	measure 'Total Profit' = [Total Sales] - [Total Cost]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 02 Profit
		lineageTag: 019febcb-79cf-44cc-b5b9-ada2a153b809

	measure 'Profit Margin %' = DIVIDE ( [Total Profit], [Total Sales] )
		formatString: 0.00%
