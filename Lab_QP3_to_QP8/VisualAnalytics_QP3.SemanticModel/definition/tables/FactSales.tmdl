		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 06 Time
		lineageTag: ea7cb180-7bc9-4f97-8890-749dc5a536cf

	measure 'Best Month Name' =
			VAR T = TOPN ( 1, VALUES ( DimDate[YearMonth] ),
