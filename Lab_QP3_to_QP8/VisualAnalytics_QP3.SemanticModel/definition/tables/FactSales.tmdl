		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 06 Time
		lineageTag: d72d146c-f947-46af-95aa-8f2c0ef17cf9

	measure 'Electronics YoY %' =
			VAR Cur =
			    CALCULATE ( [Total Sales],
			                DimProduct[Category] = "Electronics" )
			VAR Prev =
			    CALCULATE ( [Total Sales],
			                DimProduct[Category] = "Electronics",
			                SAMEPERIODLASTYEAR ( DimDate[Date] ) )
			RETURN
			    DIVIDE ( Cur - Prev, Prev )
		formatString: 0.00%
		displayFolder: 06 Time
		lineageTag: f8773e9e-4af1-4a6d-b19f-018ecc8447e9

	measure 'Best Month Sales' =
			MAXX ( VALUES ( DimDate[YearMonth] ),
