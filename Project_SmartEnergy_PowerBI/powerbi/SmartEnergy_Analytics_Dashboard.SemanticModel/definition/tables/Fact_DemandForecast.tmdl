		lineageTag: 02f8c975-6663-4545-8565-f516e7b659be

	column Type
		dataType: string
		summarizeBy: none
		sourceColumn: Type
		lineageTag: 62411e6b-57b0-442c-b5c2-8103050479d6

	column Actual_kWh
		dataType: double
		formatString: #,0.0
