table Fact_DemandForecast
	lineageTag: 6ee58cd5-6fcf-44bd-a077-c5d111200929

	measure 'Forecast Projected Demand (kWh)' = SUM(Fact_DemandForecast[Forecast_kWh])
		formatString: #,0.0
		lineageTag: c0af80ff-445b-4578-bf6d-c0f3e58ba1bd

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date
		lineageTag: 66710fbe-c37c-4904-a273-716424bc972d

	column Type
		dataType: string
		summarizeBy: none
		sourceColumn: Type
		lineageTag: 528f87f7-0eab-44e9-bfbf-a37d71c26686

	column Actual_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Actual_kWh
		lineageTag: 9ee8c7aa-4e2d-477d-a1c4-66b57db658bf

	column Forecast_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Forecast_kWh
		lineageTag: 19c2ef69-6326-4264-8d77-6c3324a511f0

	column Lower95_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Lower95_kWh
		lineageTag: b2a61ffa-9d8f-438e-b59d-84442a5bce47

	column Upper95_kWh
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Upper95_kWh
		lineageTag: df02e644-3c5c-43df-bafa-73ae6d05dbc5

	partition Fact_DemandForecast = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("C:/Users/ROG/Desktop/Mtech Classwork/Visual analytics/Project_SmartEnergy_PowerBI/data/Fact_DemandForecast.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted, {
			        {"Date", type date}, {"Type", type text}, {"Actual_kWh", type number}, {"Forecast_kWh", type number}, {"Lower95_kWh", type number}, {"Upper95_kWh", type number}
			    })
			in
			    Typed
