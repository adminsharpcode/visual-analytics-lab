	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date
		lineageTag: 50307aea-26ff-4008-90cc-9cd0cb701295

	column Type
		dataType: string
		summarizeBy: none
		sourceColumn: Type
		lineageTag: 9197aa4b-7602-4d47-9106-fdc3fb3c705b

	column Actual_kWh
		dataType: double
		formatString: #,0.0
