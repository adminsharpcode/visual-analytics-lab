table Fact_EnergyConsumption
	lineageTag: 3a9b2ec8-8736-49f6-ad11-39ae778a84b4

	measure 'Total Active Consumption (GWh)' = DIVIDE(SUM(Fact_EnergyConsumption[ActivePower_kWh]), 1000000)
		formatString: #,0.00
		lineageTag: 76e0507f-6ad2-4891-8079-2808f99bd329

	measure 'Total Electricity Spend (Cr)' = DIVIDE(SUM(Fact_EnergyConsumption[Cost_INR]), 10000000)
		formatString: \₹#,0.00;(\₹#,0.00);\₹#,0.00
		lineageTag: 6859c73f-5fa6-4133-aaad-2ff9a0bcc935

	measure 'Total Solar Generation (GWh)' = DIVIDE(SUM(Fact_EnergyConsumption[SolarGeneration_kWh]), 1000000)
		formatString: #,0.00
		lineageTag: 24aaa4f8-0b9b-4944-bdd9-1c24ca4fcd74

	measure 'Solar Penetration %' = DIVIDE(SUM(Fact_EnergyConsumption[SolarGeneration_kWh]), SUM(Fact_EnergyConsumption[ActivePower_kWh]), 0)
		formatString: 0.0%
		lineageTag: 9d020d9b-ad2a-4669-b008-33e67c1bdbf2

	measure 'Campus Peak Demand (kW)' = MAXX(VALUES(Fact_EnergyConsumption[Timestamp]), CALCULATE(SUM(Fact_EnergyConsumption[ActivePower_kWh])))
		formatString: #,0.0
		lineageTag: aaea0402-21c6-4a00-9bbd-d272772fbe88

	measure 'Carbon Footprint (tCO2e)' = DIVIDE(SUM(Fact_EnergyConsumption[Carbon_kgCO2]), 1000)
		formatString: #,0.0
		lineageTag: 4a0ad654-c2ec-4528-9388-6ee84f371aa1

	measure 'Clean Energy Offset (tCO2e)' = DIVIDE(SUM(Fact_EnergyConsumption[SolarGeneration_kWh]) * 0.82, 1000)
		formatString: #,0.0
		lineageTag: e9332f5b-8d1c-4ff1-b172-fd011b2c90dd

	measure 'Operational Anomaly Count' = CALCULATE(COUNTROWS(Fact_EnergyConsumption), Fact_EnergyConsumption[AnomalyFlag] = 1)
		formatString: #,0
		lineageTag: d4531e2d-163e-42c2-94ca-6c6e72060e5b

	measure 'Net Grid Import (GWh)' = DIVIDE(SUM(Fact_EnergyConsumption[NetImport_kWh]), 1000000)
		formatString: #,0.00
		lineageTag: 79b40cc4-6d7c-4005-8bb2-f2cd2fea38bb

	measure 'Average Power Factor' = AVERAGE(Fact_EnergyConsumption[PowerFactor])
		formatString: 0.000
		lineageTag: 7e190332-30bd-4017-951e-b8067a5c411d

	measure 'Peak Period Consumption (GWh)' = CALCULATE([Total Active Consumption (GWh)], Dim_Time[PeakTariffFlag] = 1)
		formatString: #,0.00
		lineageTag: 863a8bef-9424-4e0c-bcb4-303d6f7866d2

	measure 'Off-Peak Consumption (GWh)' = CALCULATE([Total Active Consumption (GWh)], Dim_Time[PeakTariffFlag] = 0)
		formatString: #,0.00
		lineageTag: 5848b3f2-4751-477c-b52b-cbbef7df34a7

